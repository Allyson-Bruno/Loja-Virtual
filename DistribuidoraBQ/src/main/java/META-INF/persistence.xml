<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0" xmlns="https://jakarta.ee/xml/ns/persistence" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">
	<persistence-unit name="lojavirtual">
		<provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
		<class>ti.modelo.Produto</class>
		<class>ti.modelo.Usuario</class>
		<class>ti.modelo.NotaFiscal</class>
		<class>ti.modelo.ItemNota</class>		
		<properties>
			<property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect" />
			<property name="hibernate.hbm2ddl.auto" value="update" />
			<property name="hibernate.show_sql" value="true" />
			<property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver" />
			<property name="jakarta.persistence.jdbc.user" value="postgres" />
			<property name="jakarta.persistence.jdbc.password" value="aluno" />
			<property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/lojavirtual" />
		</properties>
	</persistence-unit>
</persistence>
